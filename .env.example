# Both values are public by design — they appear in the shipped HTML.
# Neither is a secret; do not treat them as one.

# Contact form delivery. Get a key at https://web3forms.com (bound to
# SHJRising@aol.com). Without this the form silently fails to deliver.
PUBLIC_WEB3FORMS_KEY=

# Cloudflare Web Analytics site token. Leave blank locally — the beacon is
# only rendered when this is set, so nothing loads in development.
PUBLIC_CF_ANALYTICS_TOKEN=
