---
import { site } from "@/data/site";

const { pathname } = Astro.url;

/** Trailing slashes are off in the Astro config, but be defensive. */
const current = pathname.replace(/\/$/, "") || "/";

/**
 * Labels are kept short deliberately: six links plus a call to action plus the
 * wordmark is already most of a laptop’s width, and a nav that wraps to two
 * lines reads as broken. The longer, more descriptive titles live in the page
 * <h1>s and the footer, where there’s room for them.
 */
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About Holly" },
  { href: "/cat-sitting", label: "Cat Sitting" },
  { href: "/snowbird-cat-care", label: "Snowbirds" },
  { href: "/reviews", label: "Reviews" },
  { href: "/faq", label: "FAQ" },
];

const isCurrent = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="wordmark" aria-label={`${site.name} — home`}>
      <span class="wordmark__paw" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
          <ellipse cx="7" cy="8" rx="2.3" ry="3" />
          <ellipse cx="12" cy="6" rx="2.3" ry="3.2" />
          <ellipse cx="17" cy="8" rx="2.3" ry="3" />
          <ellipse cx="20" cy="13" rx="2" ry="2.6" />
          <path
            d="M12 12c3.2 0 5.8 2.4 5.8 5.1 0 2-1.5 3.2-3.5 3.2-1 0-1.6-.3-2.3-.3s-1.3.3-2.3.3c-2 0-3.5-1.2-3.5-3.2C6.2 14.4 8.8 12 12 12Z"
          />
        </svg>
      </span>
      <span class="wordmark__text">
        <span class="wordmark__line1">Best In Boca</span>
        <span class="wordmark__line2">Pet Sitters</span>
      </span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <line x1="3" y1="7" x2="21" y2="7"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="17" x2="21" y2="17"></line>
      </svg>
    </button>

    <nav id="primary-nav" class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="site-nav__link"
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__cta">
          <a href="/contact" class="btn btn--primary">Free meet &amp; greet</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // The only scripted behaviour in the header: open and close the mobile
  // drawer, keeping aria-expanded honest so screen readers track state.
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const nav = document.getElementById("primary-nav");

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      nav.classList.toggle("is-open", open);
      document.body.classList.toggle("nav-open", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Escape closes, and focus goes back to the button that opened it.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });

    // Following a link inside the drawer should close it.
    nav.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--c-cream) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: 4.5rem;
  }

  /* --- Wordmark ------------------------------------------------------- */

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    color: var(--c-plum);
    flex-shrink: 0;
  }

  .wordmark__paw {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-full);
    background-color: var(--c-blush);
    color: var(--c-rose);
  }

  .wordmark__text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 40, "WONK" 1;
    line-height: 1.05;
  }

  .wordmark__line1 {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .wordmark__line2 {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--c-ink-muted);
  }

  /* --- Toggle --------------------------------------------------------- */

  .nav-toggle {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--c-border-strong);
    border-radius: var(--r-md);
    background-color: var(--c-surface);
    color: var(--c-plum);
  }

  /* --- Nav ------------------------------------------------------------ */

  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    display: block;
    padding: var(--sp-3) var(--sp-2);
    color: var(--c-plum);
    text-decoration: none;
    font-weight: 600;
    border-radius: var(--r-sm);
    /* A nav that wraps to two lines reads as broken. */
    white-space: nowrap;
  }

  .site-nav__link:hover {
    color: var(--c-rose);
  }

  .site-nav__link[aria-current="page"] {
    color: var(--c-rose);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* Mobile: a drawer below the bar, hidden until toggled. */
  @media (max-width: 67.999em) {
    .site-nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      display: none;
      padding: var(--sp-4) var(--gutter) var(--sp-6);
      background-color: var(--c-cream);
      border-bottom: 1px solid var(--c-border);
      box-shadow: var(--shadow-md);
    }

    .site-nav.is-open {
      display: block;
    }

    .site-nav__link {
      padding: var(--sp-4) var(--sp-2);
      font-size: var(--fs-lg);
      border-bottom: 1px solid var(--c-border);
    }

    .site-nav__cta {
      margin-top: var(--sp-5);
    }

    .site-nav__cta .btn {
      width: 100%;
    }
  }

  @media (min-width: 68em) {
    .nav-toggle {
      display: none;
    }

    .site-nav__list {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
    }

    .site-nav__link {
      font-size: 1rem;
      padding-inline: var(--sp-3);
    }

    .site-nav__cta {
      margin-left: var(--sp-3);
    }
  }
</style>
