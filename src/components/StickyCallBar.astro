---
import { site } from "@/data/site";
---

{/*
  Mobile-only. Most visitors arrive from Google Maps on a phone, already
  half-sold, and the single thing they need is the number — so it should never
  be more than a thumb away. Hidden on desktop, where the header CTA and the
  footer already cover it.
*/}
<div class="callbar">
  <a href={site.phone.href} class="callbar__call" data-track="tel">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
      <path
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"
      ></path>
    </svg>
    <span>Call {site.phone.display}</span>
  </a>
  <a href="/contact" class="callbar__book">Book</a>
</div>

<style>
  .callbar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-3)
      calc(var(--sp-3) + env(safe-area-inset-bottom, 0px));
    background-color: color-mix(in srgb, var(--c-cream) 96%, transparent);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--c-border-strong);
  }

  .callbar__call,
  .callbar__book {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: 3.25rem;
    border-radius: var(--r-full);
    font-weight: 700;
    text-decoration: none;
  }

  .callbar__call {
    flex: 1 1 auto;
    background-color: var(--c-rose);
    color: #fff;
    font-size: var(--fs-lg);
  }

  .callbar__book {
    flex: 0 0 auto;
    padding-inline: var(--sp-5);
    background-color: var(--c-surface);
    border: 2px solid var(--c-rose);
    color: var(--c-rose);
  }

  /* The header CTA and footer already serve desktop; a fixed bar there would
     just eat screen. */
  @media (min-width: 48em) {
    .callbar {
      display: none;
    }
  }
</style>
